{
    "name": "tenseg/cascading-entry-protection",
    "description": "A Statamic addon that allows you to restrict access to entry hierarchies.",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "Tenseg LLC",
            "email": "dev@tenseg.net",
            "homepage": "https://www.tenseg.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tenseg\\CascadingEntryProtection\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tenseg\\CascadingEntryProtection\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Cascading Entry Protection",
            "description": "A Statamic addon that allows you to restrict access to entry hierarchies."
        },
        "laravel": {
            "providers": [
                "Tenseg\\CascadingEntryProtection\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
